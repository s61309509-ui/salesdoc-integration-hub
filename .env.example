# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SalesDoc API V2 Configuration
# Base API URL for SalesDoc instance (single endpoint https://namdistribution.salesdoc.io/api/v2)
SALESDOC_BASE_URL="https://namdistribution.salesdoc.io/api/v2"

# SalesDoc API Authorization Token (REQUIRED) - Never commit actual token or hardcode!
# If your token includes userId (e.g., "d0_1:token_hash"), it will be automatically split.
SALESDOC_TOKEN=""

# SalesDoc User ID (Optional if contained in token or if token authentication doesn't require separate userId)
SALESDOC_USER_ID=""

# SalesDoc Filial code (Optional - leave empty or "0" if your instance operates without branch segregation)
SALESDOC_FILIAL_ID=""

# Request Timeout in milliseconds (default: 30000)
SALESDOC_TIMEOUT_MS="30000"

# Dry run mode: "true" to validate payloads without mutating SalesDoc
SALESDOC_DRY_RUN="false"

# Telegram Bot Integration for Agent Visit & Photo Verification
# Bot Token from @BotFather (e.g., "123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11")
TELEGRAM_BOT_TOKEN=""

# Default Telegram Group / Supervisor Chat ID (e.g., "-1001234567890")
TELEGRAM_DEFAULT_CHAT_ID=""

# Server Port & Render Keep-Alive (14-minute self-wake)
# On Render, PORT and RENDER_EXTERNAL_URL are injected automatically.
PORT="3000"
KEEP_ALIVE_URL=""
